{
  "name": "npm-publish-strict",
  "version": "0.0.0-semantically-released",
  "private": true,
  "description": "Opinionated NPM publish GitHub Action: semantic-release, typedoc, npm trusted publishing",
  "author": "Andrew Walsh",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/awalsh128/npm-publish-strict.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "fixture": "node test/make-fixture.ts",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.1.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "~9.3.1",
    "semantic-release": "^25.0.9"
  },
  "devDependencies": {
    "@actions/core": "^2.0.3",
    "@awalsh128/winston-github-actions": "^1.0.0",
    "@awalsh128/winston-host": "^1.1.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@octokit/rest": "^22.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
